# Python
.venv/
.venv-fl/
scratch/
__pycache__/
*.pyc
*.pkl
*.joblib

# Trained models (regenerated by `make baseline`).
# Exception: the two files the live backend actually loads at runtime are
# committed on purpose so the deployed service works from a fresh git clone
# with no Kaggle credentials needed at build time. `make baseline` remains
# the authoritative way to regenerate them.
models/*
!models/baseline_lgb.txt
!models/baseline_lgb_feature_spec.json

# Data (large / external — see data/README.md for how to obtain).
# Exception: test.parquet is the held-out split the replay feed streams from
# in production — committed for the same deploy-from-a-fresh-clone reason.
data/splits/*
!data/splits/test.parquet
data/*.csv
data/*.zip

# Reports: keep metrics.json, ignore generated figures
report/figures/

# Node
node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Env / secrets
.env
*.local

# Backend runtime
backend/sentinel.db
backend/*.db

# OS
.DS_Store
