# Copy to backend/.env and fill in. All optional — the replay feed runs without any
# Razorpay keys; the /api/orders, /api/verify and webhook-signature checks need them.

# Razorpay test-mode (dashboard.razorpay.com -> Test Mode -> Settings -> API Keys)
SENTINEL_RAZORPAY_KEY_ID=
SENTINEL_RAZORPAY_KEY_SECRET=
# Settings -> Webhooks -> add endpoint -> secret you choose there
SENTINEL_RAZORPAY_WEBHOOK_SECRET=

# Replay speed: held-out days streamed per real second (default 2.0 -> ~90s for the 30-day test window)
SENTINEL_REPLAY_DAYS_PER_SEC=2.0
SENTINEL_REPLAY_AUTOSTART=true
